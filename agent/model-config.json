{
  "version": "1.0.0",
  "description": "Ocean.studio default model configuration — merged with user settings from modelStore",
  "defaults": {
    "selectedModelId": "google.gemini-2.5-pro",
    "temperature": 0.7,
    "topP": 0.95,
    "maxTokens": 8192,
    "thinkingLevel": "medium",
    "strictness": "normal",
    "bypassDefaultInstructions": false,
    "scrapingProvider": "firecrawl",
    "toolsEnabled": true
  },
  "providers": {
    "google": {
      "envKey": "GOOGLE_API_KEY",
      "models": ["google.gemini-2.5-pro", "google.gemini-2.5-flash", "google.gemini-2.0-flash"]
    },
    "anthropic": {
      "envKey": "ANTHROPIC_API_KEY",
      "models": ["anthropic.claude-opus-4", "anthropic.claude-sonnet-4"]
    },
    "openai": {
      "envKey": "OPENAI_API_KEY",
      "models": ["openai.gpt-5", "openai.o3", "openai.codex"]
    },
    "custom": {
      "description": "OpenAI-compatible endpoint override via model config panel"
    }
  },
  "thinkingLevels": ["off", "low", "medium", "high", "max"],
  "strictnessLevels": ["relaxed", "normal", "strict", "maximum"],
  "scrapingProviders": {
    "electron": ["firecrawl", "puppeteer", "playwright", "fetch", "custom"],
    "web": ["firecrawl", "fetch", "custom"],
    "mobile": ["firecrawl", "fetch", "custom"]
  },
  "agentContextKeys": [
    "modelConfig",
    "mcpServers",
    "mcpMeta",
    "pluginTools",
    "providers",
    "providerContext",
    "platform",
    "capabilities",
    "terminalType",
    "workspacePath",
    "activeFile",
    "agentMode",
    "multiAgent",
    "gateway",
    "routing"
  ],
  "agentTimeout": {
    "defaultSec": 120,
    "maxSec": 900,
    "antiTimeoutSec": 600,
    "configPath": "modelStore.agentTimeoutSec / antiTimeout"
  },
  "injectedSkillFiles": [
    "agent/agent.md",
    "agent/skill.md",
    "agent/tools-skill.md",
    "agent/provider-skill.md",
    "agent/multi-agent-skill.md",
    "agent/gateway-skill.md",
    "agent/playground-skill.md",
    "agent/routing-skill.md",
    "agent/cursor-workflows-skill.md"
  ]
}
