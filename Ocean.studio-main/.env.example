# Dev terminal WebSocket (browser preview shell)
VITE_TERMINAL_WS_URL=ws://localhost:3847

# Google Cloud Shell OAuth (Electron desktop — for cloud terminal on website builds)
GOOGLE_CLOUD_CLIENT_ID=
GOOGLE_CLOUD_CLIENT_SECRET=

# GitHub OAuth Client ID + Secret for Electron GitHub workflow (import/export/commits)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Callback: http://127.0.0.1:8767/oauth/github/callback

# Optional — model provider API keys (also configurable in UI model config panel)
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
FIRECRAWL_API_KEY=

# Provider OAuth (Electron desktop — localhost:8768 callback)
