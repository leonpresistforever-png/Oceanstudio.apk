<resources>
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:colorAccent">@color/ocean_ink</item><item name="android:navigationBarColor">@color/ocean_background</item><item name="android:statusBarColor">@color/ocean_background</item><item name="android:windowLightStatusBar">true</item><item name="android:windowActionModeOverlay">true</item></style>
    <style name="AppTheme.NoActionBarLaunch" parent="AppTheme" />
    <style name="OceanIconButton" parent="Widget.AppCompat.ImageButton"><item name="android:layout_width">44dp</item><item name="android:layout_height">44dp</item><item name="android:background">?attr/selectableItemBackgroundBorderless</item><item name="android:padding">10dp</item><item name="android:tint">@color/ocean_ink</item></style>
    <style name="OceanSmallIconButton" parent="OceanIconButton"><item name="android:layout_width">38dp</item><item name="android:layout_height">38dp</item><item name="android:padding">8dp</item></style>
    <style name="OceanSendButton" parent="OceanSmallIconButton"><item name="android:background">@drawable/send_background</item><item name="android:tint">@color/ocean_background</item></style>
    <style name="OceanLoadingDot"><item name="android:layout_width">6dp</item><item name="android:layout_height">6dp</item><item name="android:background">@drawable/loading_dot</item></style>
    <style name="OceanNavItem"><item name="android:layout_width">match_parent</item><item name="android:layout_height">46dp</item><item name="android:layout_marginHorizontal">10dp</item><item name="android:background">@drawable/nav_item_background</item><item name="android:drawablePadding">12dp</item><item name="android:gravity">center_vertical</item><item name="android:paddingHorizontal">12dp</item><item name="android:textColor">#FF343230</item><item name="android:textSize">14sp</item></style>
    <style name="OceanNavLabel"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:paddingLeft">20dp</item><item name="android:paddingTop">20dp</item><item name="android:paddingBottom">8dp</item><item name="android:textAllCaps">true</item><item name="android:textColor">@color/ocean_muted</item><item name="android:textSize">11sp</item><item name="android:textStyle">bold</item></style>
    <style name="OceanNavMuted" parent="OceanNavItem"><item name="android:textColor">@color/ocean_muted</item><item name="android:textSize">14sp</item></style>
    <style name="OceanNavParent"><item name="android:layout_width">match_parent</item><item name="android:layout_height">46dp</item><item name="android:layout_marginHorizontal">10dp</item><item name="android:background">@drawable/nav_item_background</item><item name="android:gravity">center_vertical</item><item name="android:orientation">horizontal</item><item name="android:paddingHorizontal">12dp</item></style>
    <style name="OceanParentLabel"><item name="android:layout_width">0dp</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginStart">12dp</item><item name="android:layout_weight">1</item><item name="android:textColor">#FF46433F</item><item name="android:textSize">14sp</item><item name="android:textStyle">normal</item></style>
    <style name="OceanChevron"><item name="android:layout_width">18dp</item><item name="android:layout_height">18dp</item><item name="android:src">@drawable/ic_chevron</item></style>
    <style name="OceanSkeletonRow"><item name="android:layout_width">match_parent</item><item name="android:layout_height">13dp</item><item name="android:layout_marginRight">36dp</item><item name="android:background">@drawable/skeleton_background</item></style>
    <style name="OceanNavChildren"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:orientation">vertical</item><item name="android:visibility">gone</item></style>
    <style name="OceanNavChild" parent="OceanNavItem"><item name="android:paddingLeft">34dp</item><item name="android:textColor">#FF55524E</item><item name="android:textSize">13sp</item></style>
    <style name="OceanAuthLabel"><item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item><item name="android:layout_marginBottom">6dp</item><item name="android:textColor">@color/ocean_muted</item><item name="android:textSize">13sp</item><item name="android:textStyle">bold</item></style>
    <style name="OceanAuthField" parent="Widget.AppCompat.EditText"><item name="android:layout_width">match_parent</item><item name="android:layout_height">44dp</item><item name="android:background">@drawable/auth_field_background</item><item name="android:paddingHorizontal">14dp</item><item name="android:textColor">@color/ocean_ink</item><item name="android:textColorHint">@color/ocean_muted</item><item name="android:textSize">15sp</item><item name="android:fontFamily">sans</item></style>
    <style name="OceanPrimaryButton" parent="Widget.AppCompat.Button"><item name="android:layout_width">match_parent</item><item name="android:layout_height">46dp</item><item name="android:background">@drawable/primary_button_background</item><item name="android:elevation">1dp</item><item name="android:textAllCaps">false</item><item name="android:textColor">@color/ocean_background</item><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item></style>
    <style name="OceanProviderButton"><item name="android:layout_width">match_parent</item><item name="android:layout_height">44dp</item><item name="android:background">@drawable/auth_field_background</item><item name="android:drawablePadding">10dp</item><item name="android:elevation">1dp</item><item name="android:gravity">center</item><item name="android:textColor">@color/ocean_ink</item><item name="android:textSize">15sp</item><item name="android:textStyle">bold</item></style>
</resources>
