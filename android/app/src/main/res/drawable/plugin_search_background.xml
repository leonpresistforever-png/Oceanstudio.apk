<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_paper"/>
            <stroke android:width="1.5dp" android:color="@color/ocean_ink_100"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ocean_surface_2"/>
            <stroke android:width="1dp" android:color="@color/ocean_line"/>
            <corners android:radius="14dp"/>
        </shape>
    </item>
</selector>
