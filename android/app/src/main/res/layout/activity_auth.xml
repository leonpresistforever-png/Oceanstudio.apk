<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ocean_background" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center_horizontal" android:orientation="vertical"
        android:paddingHorizontal="28dp" android:paddingBottom="28dp">

        <!-- Fixed brand anchor with tight vertical spacing -->
        <Space android:layout_width="1dp" android:layout_height="24dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="@null" android:src="@drawable/ic_ocean_mark" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="9dp"
                android:fontFamily="sans" android:letterSpacing="-0.02" android:text="@string/app_name"
                android:textColor="@color/ocean_ink" android:textSize="19sp" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="24dp" android:orientation="horizontal">
            <View android:id="@+id/progress_one" android:layout_width="0dp" android:layout_height="2dp" android:layout_marginEnd="4dp" android:layout_weight="1" android:background="@drawable/progress_active" />
            <View android:id="@+id/progress_two" android:layout_width="0dp" android:layout_height="2dp" android:layout_marginHorizontal="4dp" android:layout_weight="1" android:background="@drawable/progress_inactive" />
            <View android:id="@+id/progress_three" android:layout_width="0dp" android:layout_height="2dp" android:layout_marginStart="4dp" android:layout_weight="1" android:background="@drawable/progress_inactive" />
        </LinearLayout>

        <TextView android:id="@+id/auth_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:fontFamily="sans" android:letterSpacing="-0.03" android:text="@string/welcome_back" android:textColor="@color/ocean_ink" android:textSize="26sp" android:textStyle="bold" />
        <TextView android:id="@+id/auth_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="start" android:layout_marginTop="6dp"
            android:lineSpacingMultiplier="1.15" android:text="@string/auth_subtitle" android:textColor="@color/ocean_muted" android:textSize="14sp" />

        <TextView android:id="@+id/dev_auth_indicator" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
            android:text="@string/development_auth" android:textColor="@color/ocean_muted" android:textSize="11sp" android:visibility="gone" />
        <TextView android:id="@+id/auth_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:visibility="gone" />

        <TextView style="@style/OceanAuthLabel" android:layout_marginTop="18dp" android:text="@string/email" />
        <EditText android:id="@+id/auth_email" style="@style/OceanAuthField" android:hint="@string/email_hint" android:inputType="textEmailAddress" />
        <TextView android:id="@+id/password_label" style="@style/OceanAuthLabel" android:layout_marginTop="12dp" android:text="@string/password" />
        <EditText android:id="@+id/auth_password" style="@style/OceanAuthField" android:hint="@string/password_hint" android:inputType="textPassword" />
        <TextView android:id="@+id/confirm_label" style="@style/OceanAuthLabel" android:layout_marginTop="12dp" android:text="@string/confirm_password" android:visibility="gone" />
        <EditText android:id="@+id/auth_confirm" style="@style/OceanAuthField" android:hint="@string/confirm_password_hint" android:inputType="textPassword" android:visibility="gone" />

        <TextView android:id="@+id/forgot_password" android:layout_width="match_parent" android:layout_height="32dp" android:layout_marginTop="2dp" android:layout_marginBottom="2dp" android:gravity="center_vertical|end"
            android:text="@string/forgot_password" android:textColor="@color/ocean_muted" android:textSize="13sp" />

        <!-- Structured Monochrome Error Panel per Section 6 -->
        <LinearLayout android:id="@+id/auth_error_panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="@drawable/auth_error_panel_background"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">
            <TextView android:id="@+id/auth_error_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/ocean_ink_100"
                android:textSize="13.5sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/auth_error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:textColor="@color/ocean_ink_75"
                android:textSize="12.5sp" />
            <TextView android:id="@+id/auth_error_toggle_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/auth_details_label"
                android:textColor="@color/ocean_ink_55"
                android:textSize="11sp"
                android:textStyle="bold"
                android:visibility="gone" />
            <TextView android:id="@+id/auth_error_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:fontFamily="monospace"
                android:textColor="@color/ocean_ink_40"
                android:textSize="10.5sp"
                android:visibility="gone" />
        </LinearLayout>

        <Button android:id="@+id/auth_primary" style="@style/OceanPrimaryButton" android:text="@string/sign_in" />

        <LinearLayout android:id="@+id/auth_divider" android:layout_width="match_parent" android:layout_height="32dp" android:gravity="center" android:orientation="horizontal">
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/ocean_border" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="12dp" android:text="@string/or_continue" android:textColor="#FFA8A6A3" android:textSize="12sp" />
            <View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1" android:background="@color/ocean_border" />
        </LinearLayout>

        <LinearLayout android:id="@+id/social_buttons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/google_auth" style="@style/OceanProviderButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="4dp" android:drawableStart="@drawable/ic_google" android:text="@string/google" />
            <TextView android:id="@+id/github_auth" style="@style/OceanProviderButton" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="4dp" android:drawableStart="@drawable/ic_github" android:text="@string/github" />
        </LinearLayout>

        <TextView android:id="@+id/auth_switch" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp"
            android:gravity="center" android:text="@string/no_account_signup" android:textColor="@color/ocean_muted" android:textSize="13sp" />
        <TextView android:id="@+id/dev_auth_continue" android:layout_width="match_parent" android:layout_height="40dp" android:gravity="center"
            android:text="@string/continue_development" android:textColor="@color/ocean_muted" android:textSize="12sp" android:visibility="gone" />
        <Space android:layout_width="1dp" android:layout_height="32dp" />
    </LinearLayout>
</ScrollView>
