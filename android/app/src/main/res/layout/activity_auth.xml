<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ocean_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_horizontal" android:orientation="vertical" android:paddingHorizontal="24dp" android:paddingTop="38dp" android:paddingBottom="28dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:contentDescription="@null" android:src="@drawable/ic_ocean_mark" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="@string/app_name" android:textColor="@color/ocean_ink" android:textSize="20sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="34dp" android:orientation="horizontal">
            <View android:id="@+id/progress_one" android:layout_width="0dp" android:layout_height="3dp" android:layout_marginEnd="3dp" android:layout_weight="1" android:background="@color/ocean_ink" />
            <View android:id="@+id/progress_two" android:layout_width="0dp" android:layout_height="3dp" android:layout_marginHorizontal="3dp" android:layout_weight="1" android:background="@color/ocean_border" />
            <View android:id="@+id/progress_three" android:layout_width="0dp" android:layout_height="3dp" android:layout_marginStart="3dp" android:layout_weight="1" android:background="@color/ocean_border" />
        </LinearLayout>
        <TextView android:id="@+id/auth_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="34dp" android:text="@string/welcome_back" android:textColor="@color/ocean_ink" android:textSize="28sp" android:textStyle="bold" />
        <TextView android:id="@+id/auth_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/auth_subtitle" android:textColor="@color/ocean_muted" android:textSize="15sp" />
        <TextView android:id="@+id/auth_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:background="@drawable/status_background" android:padding="12dp" android:textColor="@color/ocean_error" android:textSize="13sp" android:visibility="gone" />
        <EditText android:id="@+id/auth_email" style="@style/OceanAuthField" android:layout_marginTop="24dp" android:hint="@string/email" android:inputType="textEmailAddress" />
        <EditText android:id="@+id/auth_password" style="@style/OceanAuthField" android:layout_marginTop="12dp" android:hint="@string/password" android:inputType="textPassword" />
        <EditText android:id="@+id/auth_confirm" style="@style/OceanAuthField" android:layout_marginTop="12dp" android:hint="@string/confirm_password" android:inputType="textPassword" android:visibility="gone" />
        <TextView android:id="@+id/forgot_password" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical|end" android:text="@string/forgot_password" android:textColor="@color/ocean_ink" android:textSize="13sp" />
        <Button android:id="@+id/auth_primary" style="@style/OceanPrimaryButton" android:text="@string/sign_in" />
        <TextView android:id="@+id/auth_divider" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginVertical="20dp" android:gravity="center" android:text="@string/or_continue" android:textColor="@color/ocean_muted" android:textSize="13sp" />
        <LinearLayout android:id="@+id/social_buttons" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/google_auth" style="@style/OceanProviderButton" android:layout_marginEnd="6dp" android:text="@string/google" />
            <Button android:id="@+id/github_auth" style="@style/OceanProviderButton" android:layout_marginStart="6dp" android:text="@string/github" />
        </LinearLayout>
        <TextView android:id="@+id/auth_switch" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="14dp" android:gravity="center" android:text="@string/no_account_signup" android:textColor="@color/ocean_ink" android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
