<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ocean_background" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingTop="20dp" android:paddingBottom="40dp">

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Ocean Forge" android:textColor="@color/ocean_ink" android:textSize="26sp" android:textStyle="bold"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Ocean's local development workspace. Inspect source, run tests, build a candidate APK, verify its signing identity, then hand an update to Android."
            android:textColor="@color/ocean_muted" android:textSize="14sp"/>

        <TextView android:id="@+id/forge_sdk_badge" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/auth_field_background"
            android:paddingHorizontal="12dp" android:paddingVertical="8dp"
            android:text="min 28 · target 28 · compile 35" android:textColor="@color/ocean_ink" android:textSize="12sp"/>

        <TextView style="@style/OceanAuthLabel" android:layout_marginTop="22dp" android:text="FORGE TOOLCHAIN"/>
        <Button android:id="@+id/forge_bootstrap" style="@style/OceanPrimaryButton" android:text="Install full Forge build environment"/>
        <Button android:id="@+id/forge_seed" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="8dp" android:text="Initialize source from this Ocean APK" android:textAllCaps="false"/>
        <Button android:id="@+id/forge_detect_sdk" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="8dp" android:text="Auto-detect Android SDK adapter" android:textAllCaps="false"/>
        <Button android:id="@+id/forge_sdk_status" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="8dp" android:text="Check Android SDK adapter" android:textAllCaps="false"/>
        <EditText android:id="@+id/forge_sdk_root" style="@style/OceanAuthField" android:layout_marginTop="10dp"
            android:hint="/path/to/android-sdk" android:inputType="textNoSuggestions"/>
        <EditText android:id="@+id/forge_aapt2_path" style="@style/OceanAuthField" android:layout_marginTop="8dp"
            android:hint="/path/to/arm64/aapt2" android:inputType="textNoSuggestions"/>
        <Button android:id="@+id/forge_configure_sdk" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="8dp" android:text="Configure Android 35 + ARM64 aapt2" android:textAllCaps="false"/>

        <TextView style="@style/OceanAuthLabel" android:layout_marginTop="22dp" android:text="SOURCE WORKSPACE"/>
        <EditText android:id="@+id/forge_source_path" style="@style/OceanAuthField"
            android:hint="/path/to/OceanStudio/source" android:inputType="textNoSuggestions"/>
        <Button android:id="@+id/forge_init" style="@style/OceanPrimaryButton"
            android:layout_marginTop="10dp" android:text="Initialize from local source"/>

        <TextView style="@style/OceanAuthLabel" android:layout_marginTop="16dp" android:text="OR CLONE SOURCE"/>
        <EditText android:id="@+id/forge_repo_url" style="@style/OceanAuthField"
            android:hint="https://github.com/owner/repository.git" android:inputType="textUri"/>
        <EditText android:id="@+id/forge_repo_branch" style="@style/OceanAuthField" android:layout_marginTop="8dp"
            android:hint="Branch (optional, e.g. main)" android:inputType="textNoSuggestions"/>
        <Button android:id="@+id/forge_clone" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="8dp" android:text="Clone into Forge" android:textAllCaps="false"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
            android:text="Forge uses existing Git credentials. Do not paste an access token into the repository URL."
            android:textColor="@color/ocean_muted" android:textSize="12sp"/>

        <TextView style="@style/OceanAuthLabel" android:layout_marginTop="22dp" android:text="WORKSPACE CONTROL"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/forge_checkpoint" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="Checkpoint" android:textAllCaps="false"/>
            <Button android:id="@+id/forge_diff" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="Diff" android:textAllCaps="false"/>
            <Button android:id="@+id/forge_rollback" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="Rollback" android:textAllCaps="false"/>
        </LinearLayout>

        <TextView style="@style/OceanAuthLabel" android:layout_marginTop="22dp" android:text="BUILD PIPELINE"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <Button android:id="@+id/forge_tools" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="Toolchain" android:textAllCaps="false"/>
            <Button android:id="@+id/forge_status" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="Status" android:textAllCaps="false"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/forge_test" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="Run tests" android:textAllCaps="false"/>
            <Button android:id="@+id/forge_build" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="Build candidate" android:textAllCaps="false"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="horizontal">
            <Button android:id="@+id/forge_verify" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:text="Verify candidate" android:textAllCaps="false"/>
            <Button android:id="@+id/forge_install" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1"
                android:layout_marginStart="8dp" android:text="Update Ocean" android:textAllCaps="false"/>
        </LinearLayout>

        <TextView style="@style/OceanAuthLabel" android:layout_marginTop="22dp" android:text="SIGNING IDENTITY"/>
        <EditText android:id="@+id/forge_keystore_path" style="@style/OceanAuthField"
            android:hint="/path/to/ocean-signing.keystore" android:inputType="textNoSuggestions"/>
        <EditText android:id="@+id/forge_key_alias" style="@style/OceanAuthField" android:layout_marginTop="8dp"
            android:hint="Key alias" android:inputType="textNoSuggestions"/>
        <EditText android:id="@+id/forge_store_password" style="@style/OceanAuthField" android:layout_marginTop="8dp"
            android:hint="Keystore password" android:inputType="textPassword"/>
        <EditText android:id="@+id/forge_key_password" style="@style/OceanAuthField" android:layout_marginTop="8dp"
            android:hint="Key password" android:inputType="textPassword"/>
        <Button android:id="@+id/forge_save_signing" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="10dp" android:text="Save signing identity privately" android:textAllCaps="false"/>
        <Button android:id="@+id/forge_forget_signing" android:layout_width="match_parent" android:layout_height="46dp"
            android:layout_marginTop="6dp" android:text="Forget saved signing identity" android:textAllCaps="false"/>
        <TextView android:id="@+id/forge_signing_status" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:text="No signing identity saved"
            android:textColor="@color/ocean_muted" android:textSize="12sp"/>
        <Button android:id="@+id/forge_build_signed" style="@style/OceanPrimaryButton"
            android:layout_marginTop="10dp" android:text="Build signed candidate"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp"
            android:text="A saved identity is copied into Ocean's no-backup private storage. Passwords are encrypted by Android Keystore and only decrypted for short-lived Forge build files."
            android:textColor="@color/ocean_muted" android:textSize="12sp"/>

        <TextView style="@style/OceanAuthLabel" android:layout_marginTop="22dp" android:text="FORGE OUTPUT"/>
        <TextView android:id="@+id/forge_output" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:minHeight="180dp" android:background="@drawable/auth_field_background"
            android:fontFamily="monospace" android:padding="14dp"
            android:text="Forge is ready. Check the toolchain or initialize a source workspace."
            android:textColor="@color/ocean_ink" android:textIsSelectable="true" android:textSize="12sp"/>

        <Button android:id="@+id/forge_stop" android:layout_width="match_parent" android:layout_height="48dp"
            android:layout_marginTop="12dp" android:enabled="false" android:text="Stop active Forge task"
            android:textAllCaps="false" android:textColor="@color/ocean_error"/>
        <TextView android:id="@+id/forge_state" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="Idle" android:textColor="@color/ocean_muted" android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
