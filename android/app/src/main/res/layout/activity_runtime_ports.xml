<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ocean_background" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="60dp" android:gravity="center_vertical" android:paddingHorizontal="10dp">
        <ImageButton android:id="@+id/runtime_back" style="@style/OceanIconButton" android:contentDescription="@string/back" android:src="@drawable/ic_back" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:paddingStart="4dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/runtime_ports" android:textColor="@color/ocean_ink" android:textSize="17sp" android:textStyle="bold" />
            <TextView android:id="@+id/runtime_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="@string/runtime_ports_subtitle" android:textColor="@color/ocean_muted" android:textSize="11sp" />
        </LinearLayout>
        <ImageButton android:id="@+id/runtime_refresh" style="@style/OceanIconButton" android:contentDescription="@string/refresh" android:src="@drawable/ic_refresh" />
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ocean_border" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ScrollView android:id="@+id/runtime_list_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/runtime_ports_intro" android:textColor="@color/ocean_muted" android:textSize="14sp" android:lineSpacingExtra="3dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:background="@drawable/auth_field_background" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="12dp">
                    <EditText android:id="@+id/runtime_manual_port" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@null" android:hint="Port, for example 6080" android:inputType="number" android:maxLength="5" android:singleLine="true" android:textColor="@color/ocean_ink" android:textColorHint="@color/ocean_muted" />
                    <Button android:id="@+id/runtime_manual_open" android:layout_width="wrap_content" android:layout_height="40dp" android:background="@drawable/primary_button_background" android:minWidth="76dp" android:text="Open" android:textAllCaps="false" android:textColor="@color/ocean_background" />
                </LinearLayout>
                <TextView android:id="@+id/runtime_scan_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="22dp" android:paddingBottom="10dp" android:text="Scanning local listeners…" android:textColor="@color/ocean_ink" android:textSize="12sp" android:textStyle="bold" />
                <LinearLayout android:id="@+id/runtime_ports_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            </LinearLayout>
        </ScrollView>
        <WebView android:id="@+id/runtime_webview" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ocean_background" android:visibility="gone" />
    </FrameLayout>
    <LinearLayout android:id="@+id/runtime_browser_bar" android:layout_width="match_parent" android:layout_height="52dp" android:background="@color/ocean_warm" android:gravity="center_vertical" android:orientation="horizontal" android:paddingHorizontal="10dp" android:visibility="gone">
        <Button android:id="@+id/runtime_browser_back" android:layout_width="wrap_content" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:text="Back" android:textAllCaps="false" android:textColor="@color/ocean_ink" />
        <View android:layout_width="1dp" android:layout_height="20dp" android:background="@color/ocean_border" />
        <TextView android:id="@+id/runtime_url" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:ellipsize="middle" android:gravity="center_vertical" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="@color/ocean_muted" android:textSize="12sp" />
        <View android:layout_width="1dp" android:layout_height="20dp" android:background="@color/ocean_border" />
        <Button android:id="@+id/runtime_browser_reload" android:layout_width="wrap_content" android:layout_height="44dp" android:background="?attr/selectableItemBackgroundBorderless" android:text="Reload" android:textAllCaps="false" android:textColor="@color/ocean_ink" />
    </LinearLayout>
</LinearLayout>
