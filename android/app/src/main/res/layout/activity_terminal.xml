<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#FF111312" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="10dp">
        <ImageButton android:id="@+id/terminal_back" style="@style/OceanIconButton" android:contentDescription="@string/back" android:src="@drawable/ic_chevron" android:rotation="180" android:tint="#FFF4F3EF" />
        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/ocean_terminal" android:textColor="#FFF4F3EF" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/terminal_state" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/terminal_badge" android:paddingHorizontal="9dp" android:paddingVertical="5dp" android:text="@string/recovery_shell" android:textColor="#FFC7C5BE" android:textSize="10sp" />
    </LinearLayout>
    <TextView android:id="@+id/terminal_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="#FF1B1E1C" android:padding="10dp" android:text="@string/recovery_notice" android:textColor="#FFAAA9A4" android:textSize="12sp" />
    <ScrollView android:id="@+id/terminal_scroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <TextView android:id="@+id/terminal_output" android:layout_width="match_parent" android:layout_height="wrap_content" android:fontFamily="monospace" android:padding="12dp" android:textColor="#FFE9E8E3" android:textIsSelectable="true" android:textSize="13sp" />
    </ScrollView>
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="44dp" android:background="#FF1B1E1C" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="8dp">
            <Button android:id="@+id/key_ctrl_c" style="@style/OceanTerminalKey" android:text="Ctrl+C" />
            <Button android:id="@+id/key_tab" style="@style/OceanTerminalKey" android:text="Tab" />
            <Button android:id="@+id/key_escape" style="@style/OceanTerminalKey" android:text="Esc" />
            <Button android:id="@+id/key_up" style="@style/OceanTerminalKey" android:text="↑" />
            <Button android:id="@+id/key_down" style="@style/OceanTerminalKey" android:text="↓" />
            <Button android:id="@+id/key_left" style="@style/OceanTerminalKey" android:text="←" />
            <Button android:id="@+id/key_right" style="@style/OceanTerminalKey" android:text="→" />
        </LinearLayout>
    </HorizontalScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:background="#FF171918" android:gravity="center_vertical" android:padding="7dp">
        <EditText android:id="@+id/terminal_input" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:background="@drawable/terminal_input" android:fontFamily="monospace" android:hint="@string/terminal_input_hint" android:imeOptions="actionSend" android:inputType="text|textNoSuggestions" android:paddingHorizontal="12dp" android:singleLine="true" android:textColor="#FFF4F3EF" android:textColorHint="#FF777974" android:textSize="14sp" />
        <ImageButton android:id="@+id/terminal_send" android:layout_width="42dp" android:layout_height="42dp" android:layout_marginStart="6dp" android:background="@drawable/send_background" android:contentDescription="@string/send" android:padding="10dp" android:src="@drawable/ic_send" android:tint="#FFFFFFFF" />
    </LinearLayout>
</LinearLayout>
