<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FAFAFA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="18dp">

        <ImageButton
            android:id="@+id/plugin_back"
            style="@style/OceanIconButton"
            android:src="@drawable/ic_back"
            android:contentDescription="Back"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">
            <TextView
                android:id="@+id/plugin_hub_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Plugins"
                android:textColor="#18181B"
                android:textSize="23sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/plugin_hub_picker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="MCPs · Skills · Plugins"
                android:textColor="#71717A"
                android:textSize="12sp"/>
        </LinearLayout>

        <View
            android:layout_width="44dp"
            android:layout_height="44dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/plugin_hub_segments"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="4dp"
        android:background="@drawable/button_secondary"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="3dp"/>

    <EditText
        android:id="@+id/plugin_search"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/plugin_search_background"
        android:drawableStart="@drawable/ic_search"
        android:drawablePadding="10dp"
        android:hint="Search plugins"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="16dp"
        android:textColor="#18181B"
        android:textColorHint="#8B8B91"
        android:textSize="15sp"/>

    <FrameLayout
        android:id="@+id/plugin_hub_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

    <ScrollView
        android:id="@+id/plugin_plugins_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="22dp"
            android:paddingBottom="42dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Installed"
                android:textColor="#18181B"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:clipToPadding="false"
                android:fillViewport="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/plugin_installed_strip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"/>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/plugin_installed_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="No agent capabilities are connected yet."
                android:textColor="#71717A"
                android:textSize="13sp"
                android:visibility="gone"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:text="Agent capabilities"
                android:textColor="#18181B"
                android:textSize="17sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="Connect only the local capabilities you want Ocean Agent to use."
                android:textColor="#71717A"
                android:textSize="13sp"/>

            <LinearLayout
                android:id="@+id/plugin_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"/>

            <TextView
                android:id="@+id/plugin_search_empty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                android:gravity="center"
                android:padding="24dp"
                android:text="No matching capability found."
                android:textColor="#71717A"
                android:textSize="14sp"
                android:visibility="gone"/>
        </LinearLayout>
    </ScrollView>

    <ScrollView
        android:id="@+id/plugin_skills_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/plugin_skills_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="42dp"/>
    </ScrollView>

    <ScrollView
        android:id="@+id/plugin_mcps_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:fillViewport="true">
        <LinearLayout
            android:id="@+id/plugin_mcps_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="18dp"
            android:paddingBottom="42dp"/>
    </ScrollView>
    </FrameLayout>
</LinearLayout>
