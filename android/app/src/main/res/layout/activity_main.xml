<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="20dp">

        <TextView
            android:id="@+id/screen_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/agent"
            android:textColor="@color/ocean_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:background="@drawable/button_secondary"
            android:gravity="center"
            android:paddingHorizontal="18dp"
            android:text="@string/new_session"
            android:textColor="@color/ocean_ink"
            android:textSize="15sp" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ocean_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/model_picker"
            android:drawableStart="@drawable/ic_spark"
            android:drawablePadding="12dp"
            android:gravity="center_vertical"
            android:paddingHorizontal="18dp"
            android:text="@string/default_model"
            android:textColor="@color/ocean_ink"
            android:textSize="19sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:id="@+id/empty_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/ocean_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/empty_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/ocean_muted"
            android:textSize="16sp" />
    </LinearLayout>

    <EditText
        android:id="@+id/prompt"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/prompt_background"
        android:hint="@string/prompt_hint"
        android:paddingHorizontal="22dp"
        android:singleLine="true"
        android:textColor="@color/ocean_ink"
        android:textColorHint="@color/ocean_muted"
        android:textSize="17sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ocean_border" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="82dp"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <TextView android:id="@+id/tab_agent" style="@style/OceanTab" android:drawableTop="@drawable/ic_agent" android:text="@string/agent" />
        <TextView android:id="@+id/tab_editor" style="@style/OceanTab" android:drawableTop="@drawable/ic_editor" android:text="@string/editor" />
        <TextView android:id="@+id/tab_terminal" style="@style/OceanTab" android:drawableTop="@drawable/ic_terminal" android:text="@string/terminal" />
        <TextView android:id="@+id/tab_files" style="@style/OceanTab" android:drawableTop="@drawable/ic_files" android:text="@string/files" />
        <TextView android:id="@+id/tab_tools" style="@style/OceanTab" android:drawableTop="@drawable/ic_tools" android:text="@string/tools" />
    </LinearLayout>
</LinearLayout>
