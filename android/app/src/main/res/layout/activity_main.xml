<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/ocean_background">

    <LinearLayout android:id="@+id/main_content" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="@dimen/ocean_header_height" android:gravity="center_vertical" android:paddingHorizontal="@dimen/ocean_spacing_screen_horizontal" android:paddingTop="2dp">
            <ImageButton android:id="@+id/menu_button" style="@style/OceanIconButton" android:contentDescription="@string/open_menu" android:src="@drawable/ic_menu" android:alpha="0.85" />
            <LinearLayout android:id="@+id/header_title_block" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="4dp" android:layout_weight="1" android:orientation="vertical">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/screen_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OceanStudio" android:textColor="@color/ocean_text_primary" android:textSize="@dimen/ocean_text_title" android:textStyle="bold" />
                    <ImageView android:id="@+id/header_model_chevron" android:layout_width="14dp" android:layout_height="14dp" android:layout_marginStart="6dp" android:contentDescription="@null" android:src="@drawable/ic_chevron" app:tint="@color/ocean_text_secondary" />
                </LinearLayout>
                <TextView android:id="@+id/top_model_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Auto · tap to configure" android:textColor="@color/ocean_text_tertiary" android:textSize="11sp" />
            </LinearLayout>
            <ImageButton android:id="@+id/new_chat_button" style="@style/OceanIconButton" android:contentDescription="Start a new chat" android:src="@drawable/ic_add" />
            <ImageButton android:id="@+id/history_button" style="@style/OceanIconButton" android:contentDescription="Refresh agent session" android:src="@drawable/ic_refresh" android:alpha="0.85" />
            <ImageButton android:id="@+id/agent_controls_button" style="@style/OceanIconButton" android:contentDescription="Agent configuration drawer" android:src="@drawable/ic_side_panel" />
        </LinearLayout>

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ocean_border" />
        <FrameLayout android:id="@+id/home_stage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <studio.ocean.app.render.RoboticEyeView
            android:id="@+id/robotic_eye"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="0dp"
            android:elevation="0dp"
            android:clickable="false"
            android:contentDescription="Animated robotic eye"
            android:focusable="false"
            android:importantForAccessibility="no"
            android:alpha="0.85" />
        <LinearLayout android:id="@+id/home_skeleton" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@android:color/transparent" android:gravity="center" android:orientation="vertical" android:padding="32dp">
            <View android:layout_width="48dp" android:layout_height="48dp" android:background="@drawable/skeleton_background" />
            <View android:layout_width="210dp" android:layout_height="22dp" android:layout_marginTop="24dp" android:background="@drawable/skeleton_background" />
            <View android:layout_width="260dp" android:layout_height="14dp" android:layout_marginTop="12dp" android:background="@drawable/skeleton_background" />
        </LinearLayout>
        <ScrollView android:id="@+id/home_content" android:layout_width="match_parent" android:layout_height="match_parent" android:alpha="0" android:background="@android:color/transparent" android:fillViewport="true" android:clipToPadding="false" android:scrollbars="none">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="@dimen/ocean_spacing_screen_horizontal" android:paddingTop="24dp" android:paddingBottom="24dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="start" android:letterSpacing="0.06" android:text="YOUR AGENT, READY" android:textColor="@color/ocean_text_tertiary" android:textSize="@dimen/ocean_text_section_label" android:textStyle="bold"/>
                <TextView android:id="@+id/empty_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:fontFamily="serif" android:gravity="start" android:lineSpacingExtra="-2dp" android:text="How can Ocean help you today?" android:textColor="@color/ocean_text_primary" android:textSize="@dimen/ocean_text_hero" android:textStyle="bold"/>
                <TextView android:id="@+id/empty_message" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="start" android:text="@string/build_subtitle" android:textColor="@color/ocean_text_secondary" android:textSize="14sp"/>
                <HorizontalScrollView android:id="@+id/suggestion_carousel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:clipToPadding="false" android:paddingEnd="8dp" android:scrollbars="none">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal">
                        <TextView android:id="@+id/suggest_card_plan" style="@style/OceanSuggestionCard" android:text="Plan and execute a task with tools and terminal access" />
                        <TextView android:id="@+id/suggest_card_terminal" style="@style/OceanSuggestionCard" android:text="Work inside my terminal — packages, git, and scripts" />
                        <TextView android:id="@+id/suggest_card_build" style="@style/OceanSuggestionCard" android:text="Build or improve something in my workspace" />
                    </LinearLayout>
                </HorizontalScrollView>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="vertical">
                    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingBottom="10dp" android:text="A good place to begin" android:textColor="@color/ocean_text_secondary" android:textSize="14sp" android:textStyle="bold"/>
                    <LinearLayout android:id="@+id/starter_plan" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="?attr/selectableItemBackground" android:paddingHorizontal="4dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_agent" app:tint="@color/ocean_ink_100" android:contentDescription="@null" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Plan and execute a task" android:textColor="@color/ocean_text_primary" android:textSize="14sp"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron" app:tint="@color/ocean_text_tertiary" android:contentDescription="@null"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ocean_line"/>
                    <LinearLayout android:id="@+id/starter_terminal" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="?attr/selectableItemBackground" android:paddingHorizontal="4dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_terminal" app:tint="@color/ocean_ink_100" android:contentDescription="@null" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Work inside my terminal" android:textColor="@color/ocean_text_primary" android:textSize="14sp"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron" app:tint="@color/ocean_text_tertiary" android:contentDescription="@null"/>
                    </LinearLayout>
                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/ocean_line"/>
                    <LinearLayout android:id="@+id/starter_build" android:layout_width="match_parent" android:layout_height="52dp" android:gravity="center_vertical" android:orientation="horizontal" android:background="?attr/selectableItemBackground" android:paddingHorizontal="4dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_tools" app:tint="@color/ocean_ink_100" android:contentDescription="@null" />
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="14dp" android:text="Build or improve something" android:textColor="@color/ocean_text_primary" android:textSize="14sp"/>
                        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/ic_chevron" app:tint="@color/ocean_text_tertiary" android:contentDescription="@null"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
        </FrameLayout>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="10dp">
            <LinearLayout android:id="@+id/slash_menu" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="14dp" android:layout_marginBottom="5dp" android:background="@drawable/composer_background"
                android:elevation="10dp" android:orientation="vertical" android:paddingVertical="6dp" android:visibility="gone">
                <ScrollView android:layout_width="match_parent" android:layout_height="196dp" android:fillViewport="false" android:scrollbars="none">
                    <LinearLayout android:id="@+id/slash_options" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
            <HorizontalScrollView android:id="@+id/model_chip_row" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" android:clipToPadding="false" android:scrollbars="none">
                <LinearLayout android:id="@+id/model_chip_container" android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal" />
            </HorizontalScrollView>
            <LinearLayout android:id="@+id/composer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginHorizontal="14dp" android:background="@drawable/composer_pill_background" android:gravity="center_vertical" android:minHeight="@dimen/ocean_composer_min_height" android:orientation="horizontal" android:paddingHorizontal="6dp" android:paddingVertical="6dp">
                <ImageButton android:id="@+id/add_button" style="@style/OceanSmallIconButton" android:contentDescription="@string/add_attachment" android:src="@drawable/ic_add"/>
                <EditText android:id="@+id/prompt" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:gravity="center_vertical|start" android:hint="Message Ocean…" android:inputType="textCapSentences|textMultiLine" android:maxLines="4" android:minHeight="44dp" android:paddingHorizontal="8dp" android:paddingVertical="10dp" android:textColor="@color/ocean_text_primary" android:textColorHint="@color/ocean_text_secondary" android:textSize="16sp"/>
                <TextView android:id="@+id/model_button" android:layout_width="wrap_content" android:layout_height="32dp" android:background="@drawable/model_chip_background" android:ellipsize="end" android:gravity="center" android:maxWidth="120dp" android:paddingHorizontal="10dp" android:singleLine="true" android:text="Model" android:textColor="@color/ocean_text_secondary" android:textSize="11sp" android:visibility="gone"/>
                <ImageButton android:id="@+id/mic_button" style="@style/OceanSmallIconButton" android:contentDescription="@string/voice" android:src="@drawable/ic_mic"/>
                <ImageButton android:id="@+id/send_button" style="@style/OceanSendButton" android:layout_marginStart="4dp" android:contentDescription="@string/send" android:src="@drawable/ic_send"/>
            </LinearLayout>
            <HorizontalScrollView android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="7dp" android:clipToPadding="false" android:scrollbars="none" android:paddingStart="14dp">
                <LinearLayout android:layout_width="wrap_content" android:layout_height="match_parent" android:gravity="center_vertical" android:orientation="horizontal">
                    <TextView android:id="@+id/quick_search" style="@style/OceanUtilityChip" android:drawableStart="@drawable/ic_search" android:text="Search"/>
                    <TextView android:id="@+id/quick_files" style="@style/OceanUtilityChip" android:drawableStart="@drawable/ic_files" android:text="Files"/>
                    <TextView android:id="@+id/quick_screenshot" style="@style/OceanUtilityChip" android:drawableStart="@drawable/ic_agent" android:text="Screenshot"/>
                    <TextView android:id="@+id/quick_screen" style="@style/OceanUtilityChip" android:drawableStart="@drawable/ic_preview" android:text="Screen"/>
                    <TextView android:id="@+id/quick_voice" style="@style/OceanUtilityChip" android:drawableStart="@drawable/ic_mic" android:text="Voice"/>
                    <TextView android:id="@+id/quick_more" style="@style/OceanUtilityChip" android:text="•••"/>
                </LinearLayout>
            </HorizontalScrollView>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:paddingTop="4dp" android:text="Ocean can make mistakes. Check important details." android:textColor="@color/ocean_text_tertiary" android:textSize="10sp"/>
        </LinearLayout>
    </LinearLayout>

    <View android:id="@+id/drawer_backdrop" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/ocean_drawer_backdrop" android:clickable="true" android:visibility="gone" />

    <LinearLayout android:id="@+id/sidebar" android:layout_width="300dp" android:layout_height="match_parent" android:background="@color/ocean_sidebar_surface" android:elevation="12dp" android:orientation="vertical" android:paddingTop="12dp" android:translationX="-300dp" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:gravity="center_vertical" android:paddingHorizontal="18dp">
            <ImageView android:layout_width="28dp" android:layout_height="28dp" android:contentDescription="@null" android:src="@drawable/ic_ocean_mark" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:text="@string/app_name" android:textColor="@color/ocean_ink" android:textSize="17sp" android:textStyle="bold" />
        </LinearLayout>
        <TextView android:id="@+id/sidebar_new_chat" style="@style/OceanNavItem" android:drawableStart="@drawable/ic_new_chat" android:text="@string/new_chat" />
        <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="20dp">
                <TextView style="@style/OceanNavLabel" android:text="@string/recent" />
                <LinearLayout android:id="@+id/recent_skeleton" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="20dp">
                    <View style="@style/OceanSkeletonRow" /><View style="@style/OceanSkeletonRow" android:layout_marginTop="8dp" /><View style="@style/OceanSkeletonRow" android:layout_marginTop="8dp" />
                </LinearLayout>
                <LinearLayout android:id="@+id/recent_sessions_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" />
                <TextView android:id="@+id/no_recent_sessions" style="@style/OceanNavMuted" android:text="@string/no_recent_sessions" android:visibility="gone" />
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="20dp" android:layout_marginVertical="8dp" android:background="@color/ocean_border" />
                <LinearLayout android:id="@+id/group_workspace" style="@style/OceanNavParent"><TextView style="@style/OceanNavParentText" android:text="@string/workspace_group"/><ImageView android:id="@+id/chevron_workspace" style="@style/OceanChevron"/></LinearLayout>
                <LinearLayout android:id="@+id/workspace_children" style="@style/OceanNavChildren">
                    <TextView android:id="@+id/nav_editor" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_editor" android:text="@string/editor" />
                    <TextView android:id="@+id/nav_files" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_files" android:text="@string/files" />
                    <TextView android:id="@+id/nav_terminal" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_terminal" android:text="@string/ocean_terminal" />
                    <TextView android:id="@+id/nav_x11" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_preview" android:text="X11 Renderer" />
                    <TextView android:id="@+id/nav_preview" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_preview" android:text="@string/preview" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="20dp" android:layout_marginVertical="8dp" android:background="@color/ocean_border" />
                <LinearLayout android:id="@+id/group_agents" style="@style/OceanNavParent"><TextView style="@style/OceanNavParentText" android:text="@string/agents_group"/><ImageView android:id="@+id/chevron_agents" style="@style/OceanChevron"/></LinearLayout>
                <LinearLayout android:id="@+id/agents_children" style="@style/OceanNavChildren">
                    <TextView android:id="@+id/nav_agent" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_agent" android:text="@string/agent" />
                    <TextView android:id="@+id/nav_agent_settings" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_models" android:text="@string/agent_studio" />
                    <TextView style="@style/OceanNavChild" android:drawableStart="@drawable/ic_tools" android:text="@string/workflows" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="20dp" android:layout_marginVertical="8dp" android:background="@color/ocean_border" />
                <LinearLayout android:id="@+id/group_tools" style="@style/OceanNavParent"><TextView style="@style/OceanNavParentText" android:text="@string/tools_group"/><ImageView android:id="@+id/chevron_tools" style="@style/OceanChevron"/></LinearLayout>
                <LinearLayout android:id="@+id/tools_children" style="@style/OceanNavChildren">
                    <TextView android:id="@+id/nav_runtime_ports" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_ports" android:text="@string/runtime_ports" />
                    <TextView android:id="@+id/nav_browser" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_browser_nav" android:text="@string/browser" />
                    <TextView android:id="@+id/nav_private_browser" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_browser_private_nav" android:text="@string/secure_browser" />
                    <TextView style="@style/OceanNavChild" android:drawableStart="@drawable/ic_tools" android:text="@string/playground" />
                    <TextView style="@style/OceanNavChild" android:drawableStart="@drawable/ic_models" android:text="@string/automations" />
                </LinearLayout>
                <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginHorizontal="20dp" android:layout_marginVertical="8dp" android:background="@color/ocean_border" />
                <LinearLayout android:id="@+id/group_connections" style="@style/OceanNavParent"><TextView style="@style/OceanNavParentText" android:text="@string/connections_group"/><ImageView android:id="@+id/chevron_connections" style="@style/OceanChevron"/></LinearLayout>
                <LinearLayout android:id="@+id/connections_children" style="@style/OceanNavChildren">
                    <TextView android:id="@+id/nav_models" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_models" android:text="@string/models" />
                    <TextView android:id="@+id/nav_providers" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_connections" android:text="@string/providers" />
                    <TextView style="@style/OceanNavChild" android:drawableStart="@drawable/ic_connections" android:text="@string/mcp" />
                    <TextView android:id="@+id/nav_plugins" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_tools" android:text="Plugins" />
                </LinearLayout>
                <TextView style="@style/OceanNavLabel" android:text="@string/system_group" />
                <TextView android:id="@+id/nav_hub_plugins" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_tools" android:text="Plugins &amp; MCP hub" />
                <TextView android:id="@+id/nav_hub_device" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_agent" android:text="Device Access" />
                <TextView android:id="@+id/nav_hub_runtime" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_ports" android:text="Runtime Ports" />
                <TextView android:id="@+id/nav_hub_models" style="@style/OceanNavChild" android:drawableStart="@drawable/ic_models" android:text="Models &amp; APIs" />
                <TextView android:id="@+id/nav_crash_diagnostics" style="@style/OceanNavMuted" android:text="Crash Diagnostics" />
            </LinearLayout>
        </ScrollView>
        <TextView android:id="@+id/sign_out" style="@style/OceanNavItem" android:text="@string/sign_out" />
    </LinearLayout>
    <include android:id="@+id/agent_controls_drawer" layout="@layout/drawer_agent_controls"
        android:layout_width="320dp" android:layout_height="match_parent"
        android:layout_gravity="end" android:elevation="14dp"
        android:translationX="320dp" android:visibility="gone"/>

</FrameLayout>
