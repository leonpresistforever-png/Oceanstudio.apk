<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ocean_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">
        <ImageButton
            android:id="@+id/providers_back"
            style="@style/OceanIconButton"
            android:contentDescription="@string/back"
            android:src="@drawable/ic_back" />
        <TextView
            android:id="@+id/providers_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="4dp"
            android:text="@string/providers"
            android:textColor="@color/ocean_ink"
            android:textSize="18sp"
            android:textStyle="bold" />
        <ImageButton
            android:id="@+id/providers_search_btn"
            style="@style/OceanIconButton"
            android:contentDescription="Search providers"
            android:src="@drawable/ic_search" />
        <ImageButton
            android:id="@+id/providers_sort_btn"
            style="@style/OceanIconButton"
            android:contentDescription="Sort providers"
            android:src="@drawable/ic_sort" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/ocean_border" />

    <!-- Collapsible Search Bar -->
    <LinearLayout
        android:id="@+id/providers_search_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp">
        <EditText
            android:id="@+id/providers_search_input"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/composer_background"
            android:hint="Search providers or models…"
            android:textColorHint="@color/ocean_muted"
            android:textColor="@color/ocean_ink"
            android:textSize="14sp"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:imeOptions="actionDone" />
        <ImageButton
            android:id="@+id/providers_search_clear"
            style="@style/OceanSmallIconButton"
            android:layout_marginStart="8dp"
            android:contentDescription="Clear search"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- Filter chips row -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="4dp">
        <LinearLayout
            android:id="@+id/providers_filters_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </HorizontalScrollView>

    <TextView
        android:id="@+id/providers_intro"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="4dp"
        android:paddingBottom="8dp"
        android:text="Connect subscription accounts via official CLI bridges, direct API keys, or local runtimes."
        android:textColor="@color/ocean_muted"
        android:textSize="13sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/providers_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="24dp" />
            <LinearLayout
                android:id="@+id/providers_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone"
                android:padding="32dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="No matching providers found"
                    android:textColor="@color/ocean_muted"
                    android:textSize="14sp" />
                <Button
                    android:id="@+id/providers_reset_filter_btn"
                    android:layout_width="wrap_content"
                    android:layout_height="44dp"
                    android:layout_marginTop="12dp"
                    android:text="Reset filters"
                    android:textColor="@color/ocean_ink"
                    android:backgroundResource="@drawable/button_secondary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
